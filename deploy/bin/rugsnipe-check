#!/bin/bash
# rugsnipe-check: one screen with everything needed to judge the live bot (box helper; copy to ~/check.sh).
#   bash ~/check.sh          everything
#   bash ~/check.sh short    the current bot only: trading or not, the wallet, results since the era, copies vs the rule's
#                            own buys, the last trades (no bid A/B, routes, tiers, tweet, feed, dumper or follow tables)
# Reads only: the hot unit's journal (status line, operator/tier lines), /etc/rugsnipe/rugsnipe.toml and
# /var/lib/rugsnipe/state.db (read-only). Needs sudo for the journal and the config.
# Test hooks: CHECK_STATUS (a status line instead of the journal's), CHECK_TIERS (operator lines), CHECK_TWEETS (tweet lines),
# CHECK_FEED (tweetfeed lines), CHECK_DUMPERS (dumper lines), CHECK_FOLLOW (follow lines), CHECK_COPY (copy lines),
# CHECK_RULE_T0 (the tweet rule's start, unix s; empty = none), CHECK_AB_T0 (the bid A/B's start, unix s),
# CHECK_ERA_T0 (the era's start, unix s, instead of ~/.rugsnipe-era),
# CHECK_DB (another state.db), CHECK_PRINT_SQL=1 (print the SQL and stop).
SHORT=0; [ "${1:-}" = short ] && SHORT=1
DB=${CHECK_DB:-/var/lib/rugsnipe/state.db}
CFG=/etc/rugsnipe/rugsnipe.toml
now=$(date -u +%s)
D0=$(date -u -d "$(date -u +%Y-%m-%d) 00:00:00" +%s)
# ---- the era (2026-10-25): a fixed start set once with `date -u +%s > ~/.rugsnipe-era`; every "since" section then
# counts from it across days (journal lines included) instead of from today's first start
if [ -n "${CHECK_ERA_T0+x}" ]; then ERA=$CHECK_ERA_T0; else
  ERA=$(grep -m1 -oE '^[0-9]{9,11}' "$HOME/.rugsnipe-era" 2>/dev/null)
fi
E0=${ERA:-$D0}
if [ -n "$ERA" ]; then SINCE="since the era started ($(date -u -d "@$ERA" '+%b %d %H:%M') UTC)"; RN=era; else SINCE=today; RN='new rule'; fi
if [ -n "${CHECK_STATUS:-}" ]; then
  ST=$CHECK_STATUS; T0=${CHECK_T0:-$D0}; PID=0
else
  PID=$(systemctl show -p MainPID --value rugsnipe-hot)
  T0=$(date -d "$(systemctl show -p ActiveEnterTimestamp --value rugsnipe-hot)" +%s 2>/dev/null || echo "$D0")
  ST=$(sudo journalctl -u rugsnipe-hot -o cat _PID="$PID" --since "@$T0" 2>/dev/null | grep -E '^\[ *[0-9]+s\]' | tail -1)
fi
g() { grep -oE "$1" <<<"$ST" | head -1; }
num() { grep -oE '[0-9]+' <<<"$1" | head -1; }
sol() { awk -v l="${1:-0}" 'BEGIN { printf "%.4f", l / 1e9 }'; }
cfgv() { sudo grep -m1 -E "^$1 = " "$CFG" 2>/dev/null | sed -E "s/^$1 = //; s/[[:space:]]*#.*$//"; }
list_sol() { tr -d '[]_ ' <<<"$1" | awk -F, '{ for (i = 1; i <= NF; i++) printf "%s%g", (i > 1 ? "/" : ""), $i / 1e9 }'; }
list_m() { tr -d '[]_ ' <<<"$1" | awk -F, '{ for (i = 1; i <= NF; i++) printf "%s%g", (i > 1 ? "/" : ""), $i / 1e6 }'; }

# ---- the operator lines (tier per mint) of today, every process
if [ -n "${CHECK_TIERS+x}" ]; then OPL=$CHECK_TIERS; else
  OPL=$(sudo journalctl -u rugsnipe-hot -o cat --since "@$E0" 2>/dev/null | grep -E '^operator [1-9A-HJ-NP-Za-km-z]{8} hold_to create\+[0-9]+ .*tier [0-9]\)')
fi
TIERS=$(awk 'NF >= 2 { t = $NF; gsub(/[^0-9]/, "", t); if (t != "") printf "%s(\x27%s\x27,%s)", (n++ ? "," : ""), $2, t }' <<<"$OPL")
[ -n "$TIERS" ] || TIERS="('',-1)"
# ---- the tweet rule's start (docs/13): the first "tweet check:" start line of today, so its trades are counted apart
# from the bot's earlier rules ("rule" scope); empty when the check is off
if [ -n "${CHECK_RULE_T0+x}" ]; then TR=$CHECK_RULE_T0; elif [ -n "$ERA" ]; then TR=$ERA; else
  TR=$(sudo journalctl -u rugsnipe-hot -o short-unix --since "@$D0" 2>/dev/null | grep -m1 -E 'tweet check: (log|on|exit)' | awk '{ printf "%d", $1 }')
fi
# ---- the bid A/B's start (bid.ab_by_tier): the first "bid ab:" start line of today (the split before 2026-10-25 sent
# every pump.fun mint to the second arm, so earlier races are left out); else the rule's start
if [ -n "${CHECK_AB_T0+x}" ]; then AB=$CHECK_AB_T0; else
  AB=$(sudo journalctl -u rugsnipe-hot -o short-unix --since "@$E0" 2>/dev/null | grep -m1 -E 'bid ab: ' | awk '{ printf "%d", $1 }')
fi
AB=${AB:-${TR:-$D0}}
# ---- the tweet check's verdict lines (entry.tweet_gate, docs/13) of today: mint8 -> verdict, delay, slot offset
if [ -n "${CHECK_TWEETS+x}" ]; then TWL=$CHECK_TWEETS; else
  TWL=$(sudo journalctl -u rugsnipe-hot -o cat --since "@$E0" 2>/dev/null | grep -E '^tweet [1-9A-HJ-NP-Za-km-z]{8} [a-z_]+ rank ')
fi
TWEETS=$(awk '{ ms = $13; gsub(/[^0-9]/, "", ms); so = $14; gsub(/[^0-9]/, "", so); if (ms != "") printf "%s(\x27%s\x27,\x27%s\x27,%s,%s)", (n++ ? "," : ""), $2, $3, ms, (so == "" ? 0 : so) }' <<<"$TWL")
[ -n "$TWEETS" ] || TWEETS="('','',0,0)"
# ---- the tweet feed's calls (entry.tweet_feed, docs/14 section 7) of today: mint8 -> first / copy / none
if [ -n "${CHECK_FEED+x}" ]; then FDL=$CHECK_FEED; else
  FDL=$(sudo journalctl -u rugsnipe-hot -o cat --since "@$E0" 2>/dev/null | grep -E '^tweetfeed [1-9A-HJ-NP-Za-km-z]{8} [a-z]+ posts ')
fi
FEEDS=$(awk '{ printf "%s(\x27%s\x27,\x27%s\x27)", (n++ ? "," : ""), $2, $3 }' <<<"$FDL")
[ -n "$FEEDS" ] || FEEDS="('','')"
# ---- the dumper list's hits (entry.dumper_skip, docs/15) of today: mint8 -> skipped / logged, uri host ('-': none or
# a line from before the host was journaled)
if [ -n "${CHECK_DUMPERS+x}" ]; then DML=$CHECK_DUMPERS; else
  DML=$(sudo journalctl -u rugsnipe-hot -o cat --since "@$E0" 2>/dev/null | grep -E '^dumper [1-9A-HJ-NP-Za-km-z]{8} (skipped|logged)')
fi
DUMPS=$(awk 'NF >= 3 { h = ($(NF-1) == "host") ? $NF : "-"; gsub(/\x27/, "", h); printf "%s(\x27%s\x27,\x27%s\x27,\x27%s\x27)", (n++ ? "," : ""), $2, $3, h }' <<<"$DML")
[ -n "$DUMPS" ] || DUMPS="('','','')"
# ---- the follow verdicts (entry.follow, docs/16): mint8 -> yes / no, rule (a rule coin) or the rule's skip label,
# uri host, what happened (fire / skip / log: followed, not bought in log mode), the fee routing (dev / third), hot / cold
# (the record's last coins at create + 10, docs/16 section 10), the coin's mode (plain / holder[+bps<n>], section 11)
if [ -n "${CHECK_FOLLOW+x}" ]; then FLL=$CHECK_FOLLOW; else
  FLL=$(sudo journalctl -u rugsnipe-hot -o cat --since "@$E0" 2>/dev/null | grep -E '^follow [1-9A-HJ-NP-Za-km-z]{8} (yes|no) ')
fi
FOLLOWS=$(awk 'NF >= 9 { gsub(/\x27/, "", $6); f = ($9 == "fees") ? $10 : "-"; h = ($9 == "fees" && NF >= 13) ? $11 : "-"; md = ($12 == "mode") ? $13 : "-"; printf "%s(\x27%s\x27,\x27%s\x27,\x27%s\x27,\x27%s\x27,\x27%s\x27,\x27%s\x27,\x27%s\x27,\x27%s\x27)", (n++ ? "," : ""), $2, $3, $4, $6, $NF, f, h, md }' <<<"$FLL")
[ -n "$FOLLOWS" ] || FOLLOWS="('','','','','','','','')"
# ---- the copies (entry.copy, docs/17 section 9): mint8 -> his SOL, his tip (M; -1 on lines from before the tip was
# journaled), create + k, buy / log
if [ -n "${CHECK_COPY+x}" ]; then CPL=$CHECK_COPY; else
  CPL=$(sudo journalctl -u rugsnipe-hot -o cat --since "@$E0" 2>/dev/null | grep -E '^copy [1-9A-HJ-NP-Za-km-z]{8} his ')
fi
COPIES=$(awk 'NF >= 7 { tip = -1; at = $6; if ($5 == "tip") { tip = $6; gsub(/M/, "", tip); at = $8 } gsub(/[^0-9]/, "", at); printf "%s(\x27%s\x27,%s,%s,%s,\x27%s\x27)", (n++ ? "," : ""), $2, $4, tip, (at == "" ? 0 : at), $NF }' <<<"$CPL")
[ -n "$COPIES" ] || COPIES="('',0,0,0,'')"

SQL="
create temp table tiers(m8 text, tier int);
insert into tiers values $TIERS;
create temp table tweets(m8 text, kind text, ms int, slot_off int);
insert into tweets values $TWEETS;
create temp table feeds(m8 text, call text);
insert into feeds values $FEEDS;
create temp table dumps(m8 text, act text, host text);
insert into dumps values $DUMPS;
create temp table follows(m8 text, yes text, kind text, host text, act text, fees text, heat text, mode text);
insert into follows values $FOLLOWS;
create temp table copies(m8 text, his_sol real, tip_m real, at int, act text);
insert into copies values $COPIES;
create temp view pos0 as
  select p.mint, p.cost, p.state, p.opened_slot, p.closed_slot, min(s.sent_unix_ms) t_ms, max(s.bid) bid,
         coalesce((select sum(e.sol_delta) from exits e where e.mint = p.mint), 0) ex,
         (select group_concat(distinct e.reason) from exits e where e.mint = p.mint) reason,
         coalesce((select max(t.tier) from tiers t where t.m8 = substr(p.mint, 1, 8)), 0) tier,
         -- the execution the position's P&L leaves out: the filled buy's fee + tip, each filled sell's priority + tip + base fee
         coalesce((select sum(coalesce(f.fee, 0) + coalesce(f.tip, 0)) from fills f
                   where f.intent_id = p.intent_id and f.fail_reason is null), 0)
         + coalesce((select sum(coalesce(x.prio, 0) + coalesce(x.tip, 0) + 5000) from exits e join sends x on x.sig = e.sig
                     where e.mint = p.mint), 0) txc
  from positions p join sends s on s.intent_id = p.intent_id
  group by p.mint;
create temp view pos as select *, ex - cost - txc net from pos0;
create temp view races as
  select f.sig, f.fail_reason, coalesce(f.fail_cost, f.fee, 0) fail_cost, s.sent_unix_ms t_ms
  from fills f join sends s on s.sig = f.sig;
with scopes(scope, ms) as (values ('process', $T0 * 1000)${TR:+, ('$RN', $TR * 1000)}, ('today', $D0 * 1000))
select sc.scope,
  (select count(*) from races r where r.t_ms >= sc.ms) races,
  (select coalesce(sum(r.fail_reason is null), 0) from races r where r.t_ms >= sc.ms) landed,
  (select round(100.0 * coalesce(sum(r.fail_reason is null), 0) / max(count(*), 1), 0) from races r where r.t_ms >= sc.ms) land_pct,
  (select count(*) from pos where state = 'closed' and t_ms >= sc.ms) closed,
  (select coalesce(sum(net > 0), 0) from pos where state = 'closed' and t_ms >= sc.ms) wins,
  (select round(100.0 * avg(net * 1.0 / cost), 1) from pos where state = 'closed' and cost > 0 and t_ms >= sc.ms) mean_pct,
  (select round(coalesce(sum(ex - cost), 0) / 1e9, 4) from pos where state = 'closed' and t_ms >= sc.ms) curve_sol,
  (select round(-coalesce(sum(txc), 0) / 1e9, 4) from pos where state = 'closed' and t_ms >= sc.ms) tips_fees,
  (select round(-coalesce(sum(r.fail_cost), 0) / 1e9, 4) from races r where r.fail_reason is not null and r.t_ms >= sc.ms) failed_sol,
  (select round((coalesce((select sum(net) from pos where state = 'closed' and t_ms >= sc.ms), 0)
                - coalesce((select sum(r.fail_cost) from races r where r.fail_reason is not null and r.t_ms >= sc.ms), 0)) / 1e9, 4)) net_sol
from scopes sc;
.print
"
SQL_LONG="
.print == buy bid since the A/B started (bid.ab_by_tier: the mints whose first byte is odd bid the second arm, the rest bid.by_tier)
select round(b.bid / 1e6, 2) bid_m, b.attempts, coalesce(l.landed, 0) landed,
       round(100.0 * coalesce(l.landed, 0) / max(b.attempts, 1), 0) land_pct, coalesce(l.closed, 0) closed,
       coalesce(l.mean_pct, '-') mean_pct, coalesce(l.net_sol, 0.0) net_sol
from (select s.bid, count(distinct s.intent_id) attempts from sends s
      where s.kind = 'buy' and s.sent_unix_ms >= $AB * 1000 group by s.bid) b
left join (select bid, count(*) landed, sum(state = 'closed') closed,
                  round(100.0 * avg(case when state = 'closed' and cost > 0 then net * 1.0 / cost end), 1) mean_pct,
                  round(sum(case when state = 'closed' then net else 0 end) / 1e9, 4) net_sol
           from pos where t_ms >= $AB * 1000 group by bid) l on l.bid = b.bid
order by b.bid;
.print
.print == buy routes today (won = our buy landed through it, lost = it landed and failed; a bundle never lands failed)
select s.sender route, count(*) sent, coalesce(sum(s.result = 'accepted'), 0) accepted,
       coalesce(sum(f.sig is not null and f.fail_reason is null), 0) won,
       coalesce(sum(f.sig is not null and f.fail_reason is not null), 0) lost,
       round(coalesce(sum(case when f.sig is null then 0 when f.fail_reason is null then coalesce(f.fee, 0) + coalesce(f.tip, 0)
                               else coalesce(f.fail_cost, f.fee, 0) end), 0) / 1e9, 4) paid_sol,
       coalesce(group_concat(distinct nullif(s.err, '')), '-') errors
from sends s left join fills f on f.sig = s.sig
where s.kind = 'buy' and s.sent_unix_ms >= $D0 * 1000
group by s.sender order by won desc, sent desc;
.print
.print == by tier $SINCE (closed trades, after tips and fees)
select tier, count(*) trades, sum(net > 0) wins, round(100.0 * avg(net * 1.0 / cost), 1) mean_pct,
       round(sum(net) / 1e9, 4) net_sol, round(avg(cost) / 1e9, 3) avg_stake
from pos where state = 'closed' and cost > 0 and t_ms >= $E0 * 1000 group by tier order by tier;
.print
.print == tweet check $SINCE (entry.tweet_gate): verdicts by kind, how fast they came, and our closed trades by verdict since the rule started
with k as (select kind, ms, slot_off, row_number() over (partition by kind order by ms) rn,
                  count(*) over (partition by kind) n from tweets where m8 <> '')
select kind verdict, max(n) creates, sum(slot_off = 0) in_create_slot, sum(slot_off = 1) next_slot, sum(slot_off >= 2) later,
       max(case when rn = (n + 1) / 2 then ms end) median_ms
from k group by kind order by creates desc;
select coalesce((select t.kind from tweets t where t.m8 = substr(p.mint, 1, 8) limit 1), 'not fetched') verdict,
       count(*) trades, sum(net > 0) wins, round(100.0 * avg(net * 1.0 / cost), 1) mean_pct, round(sum(net) / 1e9, 4) net_sol
from pos p where state = 'closed' and cost > 0 and t_ms >= ${TR:-$D0} * 1000 group by verdict order by trades desc;
.print
.print == tweet feed $SINCE (entry.tweet_feed): its calls against the tweet check's verdict on the same coin, and our closed trades by call
select f.call, count(*) creates, coalesce(sum(t.kind = 'first'), 0) first, coalesce(sum(t.kind = 'copy'), 0) copy,
       coalesce(sum(t.kind = 'stale'), 0) stale, coalesce(sum(t.kind = 'no_tweet'), 0) no_tweet,
       coalesce(sum(t.kind = 'error'), 0) error, sum(t.kind is null) no_verdict
from feeds f left join tweets t on t.m8 = f.m8 where f.m8 <> '' group by f.call order by creates desc;
select coalesce((select f.call from feeds f where f.m8 = substr(p.mint, 1, 8) limit 1), 'not called') call,
       count(*) trades, sum(net > 0) wins, round(100.0 * avg(net * 1.0 / cost), 1) mean_pct, round(sum(net) / 1e9, 4) net_sol
from pos p where state = 'closed' and cost > 0 and t_ms >= ${TR:-$D0} * 1000 group by call order by trades desc;
.print
.print == dumper list $SINCE (entry.dumper_skip): hits by uri host, and our closed trades since the rule started by the hit's host (big = -30% or worse)
select host, count(*) hits, sum(act = 'skipped') skipped, sum(act = 'logged') fired_anyway
from dumps where m8 <> '' group by host order by hits desc;
select coalesce((select d.host from dumps d where d.m8 = substr(p.mint, 1, 8) limit 1), 'no hit') dumper_host,
       count(*) trades, sum(net > 0) wins, sum(net <= -0.3 * cost) big, round(100.0 * avg(net * 1.0 / cost), 1) mean_pct,
       round(sum(net) / 1e9, 4) net_sol
from pos p where state = 'closed' and cost > 0 and t_ms >= ${TR:-$D0} * 1000 group by dumper_host order by trades desc;
.print
.print == follow $SINCE (entry.follow, docs/16): verdicts at the fire (rule = our rule's coin; skip_* = a coin our rule skips,
.print    parked for its verdict: log = followed but not bought in log mode), and our closed trades by the verdict
select kind, fees, heat, mode, yes followed, count(*) coins, sum(act = 'fire') fired, sum(act = 'skip') skipped, sum(act = 'log') logged
from follows where m8 <> '' group by kind, fees, heat, mode, yes order by kind = 'rule' desc, coins desc;
select coalesce((select f.yes || ' ' || f.kind || ' ' || f.heat || ' ' || f.mode from follows f where f.m8 = substr(p.mint, 1, 8) limit 1), 'no verdict') follow,
       count(*) trades, sum(net > 0) wins, sum(net <= -0.3 * cost) big, round(100.0 * avg(net * 1.0 / cost), 1) mean_pct,
       round(sum(net) / 1e9, 4) net_sol
from pos p where state = 'closed' and cost > 0 and t_ms >= ${ERA:-$D0} * 1000 group by follow order by trades desc;
.print
"
SQL_TAIL="
.print == copy $SINCE (entry.copy, docs/17 section 9): his buys copied (buy) or journaled (log), and our closed trades,
.print    the copies apart from the rule's own fires
select act, count(*) copies, sum(at = 0) at_create, sum(at = 1) next_slot, round(avg(his_sol), 2) his_avg_sol,
       round(avg(case when tip_m >= 0 then tip_m end), 1) his_avg_tip_m
from copies where m8 <> '' group by act;
select case when exists (select 1 from copies c where c.m8 = substr(p.mint, 1, 8) and c.act = 'buy') then 'copy' else 'rule' end source,
       count(*) trades, sum(net > 0) wins, sum(net <= -0.3 * cost) big, round(100.0 * avg(net * 1.0 / cost), 1) mean_pct,
       round(sum(net) / 1e9, 4) net_sol
from pos p where state = 'closed' and cost > 0 and t_ms >= ${ERA:-$D0} * 1000 group by source order by source;
.print
.print == last 10 trades, newest first (pct and net_sol after tips and fees)
select strftime('%H:%M:%S', t_ms / 1000, 'unixepoch') time, substr(mint, 1, 8) mint, tier, round(cost / 1e9, 3) stake,
       case when state = 'closed' then round(100.0 * net / max(cost, 1), 1) end pct,
       case when state = 'closed' then round(net / 1e9, 4) end net_sol, round(txc / 1e9, 4) tips_fees, state,
       coalesce(reason, '-') exit, case when closed_slot is not null then closed_slot - opened_slot end held_slots
from pos where t_ms >= ${ERA:-0} * 1000 order by t_ms desc limit 10;
.print
.print == open now
select count(*) open_now, coalesce(group_concat(substr(p.mint, 1, 8) || ' tier '
         || coalesce((select max(t.tier) from tiers t where t.m8 = substr(p.mint, 1, 8)), 0), ', '), '-') positions
from positions p where p.state <> 'closed';
.print
.print == risk ledger today
select day, round(realized / 1e9, 4) realized_sol, buys, killed, coalesce(kill_reason, '-') kill_reason
from risk where day = date('now');
"
if [ "$SHORT" = 1 ]; then SQL="$SQL$SQL_TAIL"; else SQL="$SQL$SQL_LONG$SQL_TAIL"; fi
if [ "${CHECK_PRINT_SQL:-}" = 1 ]; then printf '%s\n' "$SQL"; exit 0; fi

# ---- header: health, wallet, config, feeds, gates
svc() { systemctl is-active "$1" 2>/dev/null || true; }
q() { echo "${1:-?}"; }
up=$(num "$(g '^\[ *[0-9]+s\]')"); wallet=$(num "$(g 'wallet [0-9]+')"); open=$(num "$(g 'positions [0-9]+')")
nonces=$(num "$(g 'sell_nonces [0-9]+')"); failc=$(num "$(g 'fail_cost [0-9]+')")
grpc_rc=$(g 'grpc: creates [0-9]+ miss [0-9]+ reconnects [0-9]+' | grep -oE '[0-9]+$')
grpc_age=$(g 'grpc: creates [0-9]+ miss [0-9]+ reconnects [0-9]+ since_frame [0-9]+' | grep -oE '[0-9]+$')
desh_rc=$(g 'shreds: creates [0-9]+ miss [0-9]+ reconnects [0-9]+' | grep -oE '[0-9]+$')
table=$(num "$(sudo journalctl -u rugsnipe-hot -o cat _PID="$PID" 2>/dev/null | grep -m1 -oE 'operators: [0-9]+ signers')")
next=$(systemctl list-timers rugsnipe-operators.timer --no-legend 2>/dev/null | awk '{print $3}' | cut -c1-5)
if [ "$SHORT" = 1 ]; then
  killed=$(g 'killed [a-z_]+' | awk '{ print $2 }')
  paused=$(g 'BUYS PAUSED|FEED STALE')
  if [ "$(svc rugsnipe-hot)" != active ]; then state="NO: the hot service is $(svc rugsnipe-hot)"
  elif [ -z "$killed" ]; then state="unknown yet (no status line from this process: the hot loop prints one every minute)"
  elif [ "$killed" != no ]; then state="NO: stopped by the $killed kill (bash ~/check.sh shows its trigger; unkill once the cause is gone)"
  elif [ -n "$paused" ]; then state="NO: $paused"
  else state="yes"; fi
  echo "== $(date -u +%H:%M:%S) UTC  TRADING: $state"
  echo "   wallet $( [ -n "$wallet" ] && sol "$wallet" || echo '?') SOL  open positions $(q "$open")  daily stop $(sol "$(tr -d '_' <<<"$(cfgv max_daily_loss_lamports)")") SOL"
  cp_=$(g 'copy (log|on) seen [0-9]+ buy [0-9]+ log [0-9]+ passed [0-9]+')
  echo "   copy (this process): $(q "$cp_")"
  echo "   sends (this process): $(q "$(g 'probe attempts [0-9]+ landed [0-9]+ failed [0-9]+ dropped [0-9]+' | sed 's/probe //')")"
  echo "== results: this process (since $(date -u -d "@$T0" +%H:%M) UTC), $RN (since $(date -u -d "@${TR:-$D0}" '+%b %d %H:%M') UTC) and today"
  printf '%s\n' "$SQL" | sudo -u rugsnipe sqlite3 -readonly -header -column "$DB"
  exit 0
fi
echo "== $(date -u +%H:%M:%S) UTC  hot $(svc rugsnipe-hot)  guard $(svc rugsnipe-guard)  up $(q "$up")s  $(q "$(g 'killed [a-z_]+')")  $(g 'BUYS PAUSED|FEED STALE')"
[ -n "$up" ] || echo "   (no status line from this process yet: the hot loop prints one every minute)"
echo "   wallet $( [ -n "$wallet" ] && sol "$wallet" || echo '?') SOL  open $(q "$open")  free sell nonces $(q "$nonces")  table $(q "$table") signers  next refresh $(q "$next") UTC"
# the wallet as the bot last read it (lags a minute or two): the only number that holds every cost
w_day=$(num "$(sudo journalctl -u rugsnipe-hot -o cat --since "@$D0" 2>/dev/null | grep -E '^\[ *[0-9]+s\]' | grep -m1 -oE 'wallet [0-9]+')")
w_proc=$(num "$(sudo journalctl -u rugsnipe-hot -o cat _PID="$PID" --since "@$T0" 2>/dev/null | grep -E '^\[ *[0-9]+s\]' | grep -m1 -oE 'wallet [0-9]+')")
dsol() { [ -n "$1" ] && [ -n "$2" ] && awk -v a="$1" -v b="$2" 'BEGIN { printf "%+.4f", (b - a) / 1e9 }' || echo '?'; }
echo "   wallet change: today $(dsol "$w_day" "$wallet") SOL (from $( [ -n "$w_day" ] && sol "$w_day" || echo '?'))  this process $(dsol "$w_proc" "$wallet") SOL (from $( [ -n "$w_proc" ] && sol "$w_proc" || echo '?'))"
echo "   config: min tier $(q "$(cfgv min_stake_tier)")  stake by tier $(q "$(list_sol "$(cfgv stake_by_tier)")") SOL  bid by tier $(q "$(list_m "$(cfgv by_tier)")")M  picks $(q "$(cfgv presend_mode | tr -d '"')") (cut $(q "$(cfgv presend_cut | tr -d '"')"))  daily stop $(sol "$(tr -d '_' <<<"$(cfgv max_daily_loss_lamports)")") SOL  sell bid: hold_to + dump $(q "$(list_m "$(cfgv dump_tip_lamports)")")M, other $(q "$(list_m "$(cfgv sell_tip_lamports)")")M"
echo "   feeds: grpc reconnects $(q "$grpc_rc") last frame $(q "$grpc_age") ms  deshred reconnects $(q "$desh_rc")"
echo "   gates: $(q "$(g 'gate parked [0-9]+ fired [0-9]+')")  $(g 'presend skip t[12] scored [0-9]+ skipped [0-9]+' | sed 's/presend skip /picks /')  $(g 'template too_big [0-9]+ bundle_sol [0-9]+ dev_buy [0-9]+ uri_host [0-9]+')"
tw=$(g 'tweet (log|on|exit) asked [0-9]+ .* fired [0-9]+( cut [0-9]+)?( ring_full [0-9]+)?')
[ -n "$tw" ] && echo "   $tw"
cp_=$(g 'copy (log|on) seen [0-9]+ buy [0-9]+ log [0-9]+ passed [0-9]+')
[ -n "$cp_" ] && echo "   $cp_  (copy_min_tip $(q "$(list_m "$(cfgv copy_min_tip_lamports)")")M, bound $(q "$(cfgv copy_max_premium)"))"
echo "   sends: $(q "$(g 'probe attempts [0-9]+ landed [0-9]+ failed [0-9]+ dropped [0-9]+' | sed 's/probe //')")  failed cost $( [ -n "$failc" ] && sol "$failc" || echo '?') SOL"
echo "== this process (since $(date -u -d "@$T0" +%H:%M) UTC) and today (since 00:00 UTC)"
printf '%s\n' "$SQL" | sudo -u rugsnipe sqlite3 -readonly -header -column "$DB"
