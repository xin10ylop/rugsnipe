#!/usr/bin/env python3
"""rugsnipe-microscalp-config: turn the box's live config into the dry-run micro-scalp (docs/10-microscalp-v2.md).

    sudo python3 -I deploy/bin/rugsnipe-microscalp-config /etc/rugsnipe/rugsnipe.toml > /tmp/rugsnipe.microscalp.toml

Reads one TOML config and prints it with:
  * every key the rebuilt hot path no longer knows removed (the operator wave, pick templates, leader regions, dumper
    skip, pre-send model, stake tiers; the binary refuses unknown keys, so `rugsnipe-ctl config validate` proves none
    is left);
  * [entry] and [exit.default] set to the dry run's spec (config/paper-lead.example.toml at 0aae91c, docs/04 s2);
  * the bid at the clearing price (2M buy, 2M sells: docs/10, ms/bidcurve.py) and the probe-A pacing caps lifted to
    explicit high values (a cap of 0 refuses every buy; it is never "unlimited").
Every other line (box, secrets, feeds, senders, nonce pools, daily stop, open positions, stake) is kept as it is.
Stdlib only, no network, no writes.
"""
import re
import sys

# keys of the live (operator-wave) code the rebuild does not have, by section
DROP = {
    "entry": {
        "bundle_wallets", "dev_buy_round", "dev_buy_round_max", "dev_buy_round_min", "dev_buy_sol", "dev_buy_tol_sol",
        "dumper_skip", "leader_regions", "leader_regions_file", "max_bundle_sol", "max_post_bundle_sol",
        "min_stake_tier", "operators_exclude", "operators_file", "operators_only", "presend_cut", "presend_mode",
        "presend_model", "stake_by_tier", "uri_hosts", "uri_hosts_deny",
    },
    "bid": {"by_tier"},
    "exit.default": {"hold_to_create_slots"},
}

# the dry run's entry and exits, verbatim, plus the live bundle wait and the sell bids
SET = {
    "entry": [
        ("require_bundle", "true"),
        ("filter", '"multi_bundle"'),
        ("max_premium", "0.02"),
        ("filter_mode", '"log"'),
    ],
    "exit.default": [
        ("tp", "[[1.15, 1.0]]"),
        ("tp_basis", '"value"'),
        ("fire_on", '"trade"'),
        ("insider_sell", '"bundle"'),
        ("bundle_sell_min_lamports", "0"),
        ("no_activity_ms", "1_000"),
        ("phantom_sl", "{ after_ms = 1_000, drop = 0.15 }"),
        ("max_hold_slots", "5"),
        ("max_hold_ms", "0"),
        ("tp_slip_bps", "2500"),
        ("trail", "{ activate = 0.0, retrace_bps = 0 }"),
        ("consolidation_pct", "0"),
        ("big_buy_lamports", "[0, 0]"),
        ("sell_retry", "{ every_slots = 2, max_tries = 15, tip_mult = 2.0 }"),
        ("sell_tip_lamports", "2_000_000"),
        ("dump_tip_lamports", "2_000_000"),
    ],
    "bid": [
        ("lamports", "2_000_000"),
    ],
    "risk": [
        ("max_buys_per_hour", "600"),
        ("spread_buys_per_hour", "false"),
        ("max_probes_per_day", "6_000"),
        ("max_buys_per_op_per_day", "6_000"),
    ],
}

# inline-table fields of [probe] a / b to set (the stage caps narrow [risk]: the smaller non-zero value binds)
PROBE_STAGE = {"max_probes_per_day": "6_000"}

TAG = "  # microscalp v2 (docs/10)"
KEY = re.compile(r"^([A-Za-z0-9_]+)\s*=")
SECTION = re.compile(r"^\[([^\[\]]+)\]")


def depth(s):
    """Bracket balance of a value outside strings and comments ([ and { open, ] and } close)."""
    d, q = 0, None
    for c in s:
        if q:
            if c == q:
                q = None
            continue
        if c in "\"'":
            q = c
        elif c == "#":
            break
        elif c in "[{":
            d += 1
        elif c in "]}":
            d -= 1
    return d


def transform(text):
    out, section, skip_depth = [], None, 0
    pending = {k: list(v) for k, v in SET.items()}
    lines = text.splitlines()

    def flush(sec):
        for k, v in pending.pop(sec, []):
            out.append(f"{k} = {v}{TAG}")

    for line in lines:
        if skip_depth > 0:  # continuation of a dropped multi-line value
            skip_depth += depth(line)
            continue
        m = SECTION.match(line)
        if m:
            if section in pending:
                flush(section)
            section = m.group(1).strip()
            out.append(line)
            continue
        k = KEY.match(line)
        if k and section:
            key = k.group(1)
            if key in DROP.get(section, ()):
                skip_depth = max(0, depth(line.split("=", 1)[1]))
                continue
            sets = dict(pending.get(section, []))
            if key in sets:
                out.append(f"{key} = {sets[key]}{TAG}")
                pending[section] = [(a, b) for a, b in pending[section] if a != key]
                skip_depth = max(0, depth(line.split("=", 1)[1]))
                continue
            if section == "probe" and key in ("a", "b"):
                for f, v in PROBE_STAGE.items():
                    line = re.sub(rf"\b{f}\s*=\s*[0-9_]+", f"{f} = {v}", line)
        out.append(line)
    if section in pending:
        flush(section)
    # a section the input never had
    for sec in list(pending):
        out.append(f"[{sec}]")
        flush(sec)
    return "\n".join(out) + "\n"


def main(argv):
    if len(argv) != 2:
        sys.stderr.write(__doc__)
        return 2
    with open(argv[1], encoding="utf-8") as f:
        sys.stdout.write(transform(f.read()))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
