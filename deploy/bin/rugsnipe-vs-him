#!/usr/bin/env python3
# rugsnipe-vs-him: us against the copied wallet since the start (the era, ~/.rugsnipe-era), coin by coin. Run by
# `bash ~/check.sh him` (sudo: the api-keys credential and state.db):
#   journalctl -u rugsnipe-hot -o cat --since @START | grep '^copy ' |
#     sudo python3 -I /opt/rugsnipe/src/deploy/bin/rugsnipe-vs-him --since START [--state DB] [--api-keys FILE]
# His side, from the chain: every landed trade of his wallet since the start, summed per coin as his wallet's SOL
# change (fees and tips in), and his failed transactions apart (their fees). A coin he bought before the start is left
# out; one he still holds is open. Source (--source auto): the Helius Enhanced API (as operators_refresh.py reads it),
# else, when Helius refuses (out of credits), standard JSON-RPC: the TRITON_URL line of the keys file, else RPC_URL
# (getSignaturesForAddress, then one getTransaction per transaction).
# Our side, from state.db: each position's net after tips and fees (as rugsnipe-check counts it) and our failed buys.
# stdin: the hot unit's `copy <mint8> his <SOL> tip <M> at create+<k> -> <act>` lines since the start, what the bot did
# with each launch buy of his it saw (buy, log, skip_small, skip_unlisted, skip_few), and its `copyw <mint8> by <wallet8>
# <SOL> at create+<k> ... -> <act>` lines (entry.copy_more). --wallet another copied wallet (`bash ~/check.sh him
# <wallet>`): that wallet against the copies of it (its copyw lines), and "us" holds only those; without it, him
# against everything else we hold.
import argparse, collections, os, sqlite3, sys, time
from concurrent.futures import ThreadPoolExecutor

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "..", "analysis", "scripts", "strategy"))
import operators_refresh as orf  # noqa: E402

WHY = {
    "buy": "copied",
    "log": "journaled (copy = log)",
    "skip_small": "not copied: his tip under the floor (or his size)",
    "skip_unlisted": "not copied: operator not in the table",
    "skip_few": "not copied: operator he bought < 2 times in 24 h",
}
SYSTEM = "11111111111111111111111111111111"
WHY_W = {
    "buy": "copied",
    "log": "journaled (mode = log)",
    "skip_small": "not copied: its buy under min_sol",
}
NOT_SEEN = "not seen at create+0/1 (a later buy, or a coin outside the class filter)"


def his_trades(api, w, since):
    """His landed single-coin trades since `since` (oldest first), his failed transactions and their fees."""
    rows, fails, fail_fee, before = [], 0, 0, None
    for _ in range(500):
        j = api.enhanced(w, before)
        if isinstance(j, dict) and "continue" in j:
            before = j["continue"]
            continue
        if not j:
            break
        for t in j:
            if t["timestamp"] < since:
                continue
            if t.get("transactionError"):
                fails += 1
                fail_fee += int(t.get("fee") or 0)
                continue
            p = orf.parse_wallet_tx(t, w)
            if p:
                rows.append(p)
        before = j[-1]["signature"]
        if j[-1]["timestamp"] < since:
            break
    rows.sort(key=lambda r: (r["slot"], r["sig"]))
    return rows, fails, fail_fee


def his_trades_rpc(api, w, since, workers, fetch_failed=None):
    """`his_trades` over standard JSON-RPC: his signatures since `since`, then each transaction (the failed ones for
    their fee)."""
    sigs, before = [], None
    for _ in range(200):
        opt = {"limit": 1000, "commitment": "confirmed"}
        if before:
            opt["before"] = before
            page = api.rpc("getSignaturesForAddress", [w, opt]) or []
        else:
            # a load-balanced RPC's backends can lag on this index: the freshest of a few first pages
            pages = [api.rpc("getSignaturesForAddress", [w, opt]) or [] for _ in range(orf.FIRST_PAGE_TRIES)]
            page = max(pages, key=lambda p: p[0].get("slot", 0) if p else -1)
        sigs += [x for x in page if (x.get("blockTime") or 0) >= since]
        if len(page) < 1000 or (page[-1].get("blockTime") or 0) < since:
            break
        before = page[-1]["signature"]

    # a busy wallet's failed transactions are only counted (their fees are not read: one call each)
    if fetch_failed is None:
        fetch_failed = sum(x.get("err") is not None for x in sigs) <= 600
    skipped = [x for x in sigs if x.get("err") is not None and not fetch_failed]
    todo = [x for x in sigs if x.get("err") is None or fetch_failed]
    print(f"({len(sigs)} transactions since the start, {len(todo)} to read"
          + (f", {len(skipped)} failed ones counted only" if skipped else "") + ")", file=sys.stderr, flush=True)

    def one(x):
        tx = api.rpc("getTransaction", [x["signature"], orf.TX_OPTS])
        if not tx:
            return None
        if x.get("err") is not None:
            m = tx["transaction"]["message"]
            payer = m["accountKeys"][0] if m.get("accountKeys") else None
            return ("fail", int((tx.get("meta") or {}).get("fee") or 0) if payer == w else 0)
        p = orf.parse_wallet_rpc_tx(tx, w)
        if p:
            p["tip"] = tip_of(tx, w)
        return ("ok", p)
    rows, fails, fail_fee = [], len(skipped), 0
    with ThreadPoolExecutor(max_workers=max(1, workers)) as ex:
        for i, r in enumerate(ex.map(one, todo), 1):
            if i % 500 == 0:
                print(f"({i}/{len(todo)} read)", file=sys.stderr, flush=True)
            if r is None:
                continue
            if r[0] == "fail":
                fails += 1
                fail_fee += r[1]
            elif r[1]:
                rows.append(r[1])
    rows.sort(key=lambda r: (r["slot"], r["sig"]))
    return rows, fails, fail_fee, len(sigs)


def tip_of(tx, w):
    """The SOL `w` moves by top-level System transfers in `tx` (his tip, as the bot reads it: transfers_from), leaving
    out the transfers to itself and to token accounts (wrapping SOL to pay a coin priced in WSOL is not a tip)."""
    m, meta = tx["transaction"]["message"], tx.get("meta") or {}
    la = meta.get("loadedAddresses") or {}
    ks = list(m["accountKeys"]) + la.get("writable", []) + la.get("readonly", [])
    tokacc = {b["accountIndex"] for b in (meta.get("preTokenBalances") or []) + (meta.get("postTokenBalances") or [])}
    tot = 0
    for ix in m.get("instructions") or []:
        if ks[ix["programIdIndex"]] != SYSTEM or not ix.get("accounts") or ks[ix["accounts"][0]] != w:
            continue
        acc = ix["accounts"]
        if len(acc) > 1 and (acc[1] in tokacc or ks[acc[1]] == w):
            continue
        d = orf.b58d(ix.get("data", ""))
        if len(d) == 12 and d[:4] == b"\x02\x00\x00\x00":
            tot += int.from_bytes(d[4:12], "little")
    return tot


def rpc_url(keys):
    """(name, url) of the standard JSON-RPC in the keys file: TRITON_URL, else RPC_URL (the URL is never printed)."""
    for name in ("TRITON_URL", "RPC_URL"):
        try:
            return name, orf.read_named_url(keys, name)
        except SystemExit:
            continue
    raise SystemExit(f"no TRITON_URL or RPC_URL line in {keys}")


def per_coin(rows):
    coins = {}
    for r in rows:
        c = coins.setdefault(r["mint"], {"t": r["ts"], "s0": r["slot"], "first_buy": False, "buy": 0, "net": 0,
                                         "bought": 0.0, "held": 0.0})
        # a buy in the coin's first slot opens it (a buy and its sell in one slot sort by signature, not by order)
        c["first_buy"] |= r["tok"] > 0 and r["slot"] == c["s0"]
        c["net"] += r["delta"]
        c["held"] += r["tok"]
        if r["tok"] > 0:
            c["buy"] -= r["delta"]
            c["bought"] += r["tok"]
            c.setdefault("tip", r.get("tip"))
    for c in coins.values():
        c["closed"] = c["held"] <= 1e-3 * max(c["bought"], 1e-9)
    return {m: c for m, c in coins.items() if c["first_buy"]}


OURS = """
select p.mint, p.cost, p.state, min(s.sent_unix_ms) t_ms,
       coalesce((select sum(e.sol_delta) from exits e where e.mint = p.mint), 0)
       - p.cost
       - coalesce((select sum(coalesce(f.fee, 0) + coalesce(f.tip, 0)) from fills f
                   where f.intent_id = p.intent_id and f.fail_reason is null), 0)
       - coalesce((select sum(coalesce(x.prio, 0) + coalesce(x.tip, 0) + 5000) from exits e join sends x on x.sig = e.sig
                   where e.mint = p.mint), 0)
       -- a buy the bot adopted after calling it dropped has no landed fill: its bid + the base fee
       - case when exists (select 1 from fills f where f.intent_id = p.intent_id and f.fail_reason is null) then 0
              else coalesce((select max(x.bid) from sends x where x.intent_id = p.intent_id and x.kind = 'buy'), 0) + 5000 end net
from positions p join sends s on s.intent_id = p.intent_id
group by p.mint having t_ms >= ?
"""
FAILED = """
select f.mint, count(*), sum(coalesce(f.fail_cost, f.fee, 0)) from fills f join sends s on s.sig = f.sig
where f.fail_reason is not null and s.sent_unix_ms >= ? group by f.mint
"""


def ours(db, since):
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    pos = {m: {"cost": cost, "state": st, "t": t / 1000, "net": net} for m, cost, st, t, net in c.execute(OURS, (since * 1000,))}
    failed = {m: (n, cost) for m, n, cost in c.execute(FAILED, (since * 1000,))}
    return pos, failed


def copies_w(lines, w8):
    """mint8 -> (its SOL, '?', create + k, act) of the `copyw` lines of the wallet `w8` (any wallet: None)."""
    out = {}
    for l in lines:
        f = l.split()
        if len(f) < 15 or f[0] != "copyw" or f[2] != "by" or (w8 is not None and f[3] != w8):
            continue
        m8, act = f[1], f[-1]
        if m8 not in out or (act == "buy" and out[m8][3] != "buy"):
            out[m8] = (f[4], "?", f[6].replace("create+", ""), act)
    return out


def copies(lines):
    """mint8 -> (his SOL, his tip M, create + k, act) of his first launch buy, a `buy` line winning."""
    out = {}
    for l in lines:
        f = l.split()
        if len(f) < 8 or f[0] != "copy" or f[2] != "his":
            continue
        m8, act = f[1], f[-1]
        tip = f[5].rstrip("M") if f[4] == "tip" else "?"
        at = (f[7] if f[4] == "tip" else f[5]).replace("create+", "")
        if m8 not in out or (act == "buy" and out[m8][3] != "buy"):
            out[m8] = (f[3], tip, at, act)
    return out


def sol(l):
    return f"{l / 1e9:+.4f}"


def table(head, rows):
    w = [max(len(str(x)) for x in col) for col in zip(head, *rows)] if rows else [len(h) for h in head]
    print("  ".join(str(h).ljust(w[i]) for i, h in enumerate(head)))
    print("  ".join("-" * w[i] for i in range(len(head))))
    for r in rows:
        print("  ".join(str(x).ljust(w[i]) for i, x in enumerate(r)))


def main(argv):
    ap = argparse.ArgumentParser()
    ap.add_argument("--since", type=int, required=True, help="the start (unix s)")
    ap.add_argument("--state", default="/var/lib/rugsnipe/state.db")
    ap.add_argument("--api-keys", default="/etc/rugsnipe/keys/api-keys.toml")
    ap.add_argument("--wallet", default=orf.DEFAULT_WALLET)
    ap.add_argument("--source", choices=("auto", "helius", "rpc"), default="auto")
    ap.add_argument("--rps", type=float, default=20.0, help="request rate (Helius: at most 5)")
    ap.add_argument("--workers", type=int, default=16)
    a = ap.parse_args(argv)
    rows = None
    if a.source in ("auto", "helius"):
        try:
            rows, fails, fail_fee = his_trades(orf.Api(orf.read_rpc_url(a.api_keys), min(a.rps, 5.0)), a.wallet, a.since)
            src = "Helius Enhanced API"
        except (orf.OutOfCredits, RuntimeError, SystemExit) as e:
            if a.source == "helius":
                raise
            print(f"(Helius refused: {str(e)[:80]}; reading over standard JSON-RPC instead)", file=sys.stderr)
    if rows is None:
        name, url = rpc_url(a.api_keys)
        rows, fails, fail_fee, n = his_trades_rpc(orf.Api(url, a.rps), a.wallet, a.since, a.workers)
        src = f"JSON-RPC ({name}, {n} transactions)"
    his = per_coin(rows)
    pos, failed = ours(a.state, a.since)
    lines = sys.stdin.read().splitlines() if not sys.stdin.isatty() else []
    other = a.wallet != orf.DEFAULT_WALLET
    if other:
        # another copied wallet: our side is its copies only
        cp, why, who = copies_w(lines, a.wallet[:8]), WHY_W, a.wallet[:8]
        mine = {m for m, v in cp.items() if v[3] == "buy"}
    else:
        # him: our side is everything but the other wallets' copies
        cp, why, who = copies(lines), WHY, "him"
        mine = None
        theirs = {m for m, v in copies_w(lines, None).items() if v[3] == "buy"} - {m for m, v in cp.items() if v[3] == "buy"}
    keep = (lambda m8: m8 in mine) if other else (lambda m8: m8 not in theirs)
    pos = {m: p for m, p in pos.items() if keep(m[:8])}
    failed = {m: v for m, v in failed.items() if keep(m[:8])}
    mins = (time.time() - a.since) / 60
    print(f"== {who} vs us since the start ({time.strftime('%b %d %H:%M', time.gmtime(a.since))} UTC, "
          f"{int(mins // 60)}h{int(mins % 60):02d}m ago): {'its' if other else 'his'} trades from the chain ({src}), ours from state.db"
          + (f" (ours: the copies of {who} only)" if other else " (ours: all but the other wallets' copies)"))
    hc = [c for c in his.values() if c["closed"]]
    oc = [p for p in pos.values() if p["state"] == "closed"]
    ofail = sum(n for n, _ in failed.values())
    ofail_cost = sum(c or 0 for _, c in failed.values())
    table(["who", "coins", "closed", "wins", "net_closed_sol", "failed_tx", "failed_sol", "total_sol"], [
        [who, len(his), len(hc), sum(c["net"] > 0 for c in hc), sol(sum(c["net"] for c in hc)), fails,
         sol(-fail_fee), sol(sum(c["net"] for c in hc) - fail_fee)],
        ["us", len(pos), len(oc), sum(p["net"] > 0 for p in oc), sol(sum(p["net"] for p in oc)), ofail,
         sol(-ofail_cost), sol(sum(p["net"] for p in oc) - ofail_cost)],
    ])
    print()
    print(f"== {'its' if other else 'his'} coins since the start, newest first, and ours on each (net after fees and tips; open = still held)")
    by8 = {m[:8]: m for m in pos}
    out = []
    for m, c in sorted(his.items(), key=lambda kv: -kv[1]["t"]):
        j = cp.get(m[:8])
        p = pos.get(by8.get(m[:8], ""))
        nf = failed.get(m)
        ours_s = "-" if not p else (sol(p["net"]) if p["state"] == "closed" else "open")
        if nf and not p:
            ours_s = f"failed {nf[0]}x {sol(-(nf[1] or 0))}"
        out.append([time.strftime("%H:%M:%S", time.gmtime(c["t"])), m[:8], f"{c['buy'] / 1e9:.3f}",
                    f"{j[1]}M" if j and j[1] != "?" else (f"{c['tip'] / 1e6:.1f}M" if c.get("tip") is not None else "?"), f"create+{j[2]}" if j else "-",
                    sol(c["net"]) if c["closed"] else "open", ours_s, why.get(j[3], j[3]) if j else NOT_SEEN])
    h = "its" if other else "his"
    table(["time", "mint", f"{h}_sol", f"{h}_tip", f"{h}_buy", f"{h}_net", "our_net", f"the bot on {h} buy"], out)
    extra = [m for m in pos if m[:8] not in {k[:8] for k in his}]
    if extra:
        print()
        print(f"== our coins {who if other else 'he'} did not trade since the start")
        table(["time", "mint", "our_net"], [[time.strftime("%H:%M:%S", time.gmtime(pos[m]["t"])), m[:8],
                                               sol(pos[m]["net"]) if pos[m]["state"] == "closed" else "open"]
                                              for m in sorted(extra, key=lambda m: -pos[m]["t"])])


if __name__ == "__main__":
    main(sys.argv[1:])
