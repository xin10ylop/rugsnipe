# rugsnipe-collector -- analytics role (ohio1). The single PumpPortal connection plus
# logsSubscribe(TSLvdd...) -> analytics.db; relays frames on /run/rugsnipe/pp.sock
# (docs/06-architecture.md sections 2 and 4).
#
# Runs `python -I analysis/scripts/collector.py --config ... --db ...` (the CLI around
# rugsnipe_analysis.collector) through /opt/rugsnipe/bin/rugsnipe-pyrun, which exits 78
# (EX_CONFIG, no restart loop) while the script is not deployed. The relay socket is
# enabled by [feeds] relay in rugsnipe.toml.
# Environment contract for every Python service: RUGSNIPE_CONFIG, RUGSNIPE_STATE_DIR,
# RUGSNIPE_RUN_DIR, RUGSNIPE_DB (see docs/07-deploy.md).
#
# Type=simple until collector.py speaks sd_notify; then switch to Type=notify + WatchdogSec=60
# with `systemctl edit rugsnipe-collector`.
[Unit]
Description=rugsnipe collector (PumpPortal + logsSubscribe -> analytics.db)
Documentation=file:/opt/rugsnipe/src/docs/07-deploy.md
PartOf=rugsnipe.target
Wants=network-online.target
After=network-online.target time-sync.target
ConditionPathExists=/etc/rugsnipe/rugsnipe.toml
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
User=rugsnipe
Group=rugsnipe
WorkingDirectory=/var/lib/rugsnipe
Environment=RUGSNIPE_CONFIG=/etc/rugsnipe/rugsnipe.toml RUGSNIPE_STATE_DIR=/var/lib/rugsnipe
Environment=RUGSNIPE_RUN_DIR=/run/rugsnipe RUGSNIPE_DB=/var/lib/rugsnipe/analytics.db
Environment=PYTHONUNBUFFERED=1 RUGSNIPE_VENV=/opt/rugsnipe/venv RUGSNIPE_SRC=/opt/rugsnipe/src
ExecStart=/opt/rugsnipe/bin/rugsnipe-pyrun --script collector --config /etc/rugsnipe/rugsnipe.toml --db /var/lib/rugsnipe/analytics.db
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30
LoadCredential=api-keys:/etc/rugsnipe/keys/api-keys.toml
SetCredential=api-keys:ABSENT
UMask=0027
LimitNOFILE=65536

# hardening (no capabilities at all)
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rugsnipe /run/rugsnipe
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=rugsnipe.target
