#!/usr/bin/env bash
# rugsnipe pre-commit hook (docs/06 section 13): refuse commits that stage key material.
#
#   * any file under a keys/ directory (keys/ is gitignored; `git add -f` would bypass that);
#   * a Solana keypair: an array of exactly 64 integers 0-255 (whitespace and newlines
#     ignored) that is the whole file (or the first of a list of them), as written by
#     `solana-keygen` and `rugsnipe-ctl armset keygen`, or that is assigned to a key-like
#     name (`"secret_key": [...]`, `keypair = [...]`, ...: key, secret, seed, priv, wallet,
#     signer). Other 64-element lists (e.g. instruction account indexes in tx fixtures) pass;
#   * a PEM private key (`-----BEGIN ... PRIVATE KEY-----`, incl. RSA/EC/OPENSSH/ENCRYPTED).
#
# Enable once per clone:   git config core.hooksPath .githooks
# (deploy/install.sh does this). Scan the staged tree by hand: .githooks/pre-commit --all
# A genuine false positive can be committed with `git commit --no-verify` after review.
set -uo pipefail

BYTE='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
KEYPAIR="\[($BYTE,){63}$BYTE\]"
KP_WHOLE="^\[?$KEYPAIR"
KP_NAMED="(key|secret|seed|priv|wallet|signer)[A-Za-z0-9_.-]*[\"']?[:=]\[?$KEYPAIR"
PEM='-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----'

if [ "${1:-}" = "--all" ]; then
    list() { git ls-files -z; }
    show() { cat -- "$1" 2>/dev/null; }
else
    list() { git diff --cached --name-only -z --diff-filter=ACMR; }
    show() { git show ":$1" 2>/dev/null; }
fi

bad=0
while IFS= read -r -d '' f; do
    case "/$f" in
        */keys/*)
            echo "pre-commit: REFUSED $f: files under keys/ never go into git" >&2
            bad=1
            continue
            ;;
    esac
    # PEM private keys (text search, binary-safe)
    if show "$f" | LC_ALL=C grep -aEq -- "$PEM"; then
        echo "pre-commit: REFUSED $f: contains a PEM private key" >&2
        bad=1
    # 64-byte keypair arrays, whitespace/newlines removed so pretty-printed JSON matches too
    elif show "$f" | LC_ALL=C tr -d ' \t\r\n' | LC_ALL=C grep -aEiq -- "$KP_WHOLE|$KP_NAMED"; then
        echo "pre-commit: REFUSED $f: contains a 64-byte keypair array (Solana keypair JSON)" >&2
        bad=1
    fi
done < <(list)

if [ "$bad" -ne 0 ]; then
    echo "pre-commit: key material must never be committed (docs/06 section 13)." >&2
    echo "pre-commit: unstage it (git restore --staged <file>); if this is a reviewed false positive, git commit --no-verify." >&2
    exit 1
fi
exit 0
